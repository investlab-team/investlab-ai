# Copy to a private team config file. Get restricted research + S3 settings securely.
INVESTLAB_APP_IMAGE=investlab-ai:shared
RESEARCH_DB_URL=
INVESTLAB_AI_OBJECT_BUCKET=disclosures
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
# Use different values for each person's AI server; retain them across restarts.
INVESTLAB_AI_INSTANCE_ID=
INVESTLAB_AI_SERVICE_TOKEN=
INVESTLAB_AI_OPENAI_MODEL=gpt-6.1-sol
INVESTLAB_AI_BASIC_ANALYSIS_TOKENS=16000
INVESTLAB_CHAT_PORT=8000
# Optional for existing basic analyses; required for new reports/follow-up generation.
INVESTLAB_AI_DART_API_KEY=
INVESTLAB_AI_OPENAI_API_KEY=
# Personal Toss access only; each client key has one valid token. Do not share it across PCs.
INVESTLAB_AI_TOSS_CLIENT_ID=
INVESTLAB_AI_TOSS_CLIENT_SECRET=
# Leave empty for cached SEC reports. For new filings: InvestLabAI contact=your-real-email
# The contact is sent only in SEC request headers; never commit its real value.
INVESTLAB_AI_SEC_USER_AGENT=
INVESTLAB_AI_SEC_REQUESTS_PER_SECOND=2
INVESTLAB_AI_SEC_BASIC_ANALYSIS_TOKENS=10000
