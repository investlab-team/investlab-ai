# 서버는 --env-file .env를 지정할 때만 읽습니다. Settings는 자동 로딩하지 않습니다.
INVESTLAB_AI_SERVICE_TOKEN=
# 서비스 토큰은 32자 이상 난수. 실제 값을 커밋하지 않습니다.
INVESTLAB_AI_DART_API_KEY=
INVESTLAB_AI_OPENAI_API_KEY=
# 본인 OpenAI API 프로젝트에서 사용 가능한 Responses/Structured Outputs 지원 모델 ID
INVESTLAB_AI_OPENAI_MODEL=
INVESTLAB_AI_EMBEDDING_MODEL=text-embedding-3-small

# 로컬 개발 전용. PostgreSQL로 연동할 때 이 줄을 제거하세요(빈 문자열로 두지 않음).
INVESTLAB_AI_LOCAL_SQLITE_PATH=.local/research.db
INVESTLAB_AI_ENABLE_DOCS=true
INVESTLAB_AI_ENABLE_LOCAL_CHAT=true
# setup-postgres.cmd가 데이터 이전 검증 후 true로 설정합니다.
INVESTLAB_AI_USE_DOCKER_DB=false
# 토크나이저 최초 사용 시 공식 인코딩 파일을 내려받고 이후 로컬 캐시를 재사용합니다.
TIKTOKEN_CACHE_DIR=.local/tiktoken
INVESTLAB_AI_MAX_ANALYSIS_CALLS=40

# PostgreSQL 16 / 기업분석 DB. URL.create로 비밀번호를 안전하게 조합합니다.
RESEARCH_DB_HOST=localhost
RESEARCH_DB_PORT=5432
RESEARCH_DB_NAME=investlab_research
RESEARCH_DB_USERNAME=investlab_research
RESEARCH_DB_PASSWORD=
# 로컬 Docker 초기화용 관리자 비밀번호. setup-postgres.cmd가 별도 난수를 생성합니다.
# 앱은 위 RESEARCH_DB_USERNAME/PASSWORD로 접속하며 관리자 계정을 사용하지 않습니다.
RESEARCH_DB_ADMIN_PASSWORD=
# SQLAlchemy dialect: postgresql+psycopg (Psycopg 3)

# 공용 Neon은 .env.local(CLI 관리자/파일 저장소) + .env.neon(AI 전용 연결)로 분리합니다.
# start-chat.cmd는 .env.neon이 있으면 Neon을 사용합니다. 로컬 DB는 start-local-chat.cmd.
# 실제 값은 .env.neon에 보관하고 커밋하지 마세요.
# RESEARCH_DB_URL=postgresql://APP_USER:APP_PASSWORD@POOLED_HOST/investlab_research?sslmode=require
# RESEARCH_DB_DIRECT_URL=postgresql://APP_USER:APP_PASSWORD@DIRECT_HOST/investlab_research?sslmode=require
# INVESTLAB_AI_OBJECT_BUCKET=disclosures
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_ENDPOINT_URL_S3 / AWS_REGION
# 팀원의 프로세스 구분은 개인별 32자 이상 서비스 토큰 또는 고유 INSTANCE_ID를 사용합니다.
INVESTLAB_AI_INSTANCE_ID=
