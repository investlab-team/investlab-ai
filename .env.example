# 자동 .env 로딩 없음. IDE/실행 환경에 설정합니다.
INVESTLAB_AI_SERVICE_TOKEN=
# 서비스 토큰은 32자 이상 난수. 실제 값을 커밋하지 않습니다.
# DB/LLM/임베딩 설정은 제공자 계약 구현 시 추가합니다.

# PostgreSQL 16 / 기업분석 DB. Repository 구현 시 SQLAlchemy URL.create로 조합합니다.
RESEARCH_DB_HOST=localhost
RESEARCH_DB_PORT=5432
RESEARCH_DB_NAME=investlab_research
RESEARCH_DB_USERNAME=investlab_research
RESEARCH_DB_PASSWORD=
# SQLAlchemy dialect: postgresql+psycopg (Psycopg 3)
