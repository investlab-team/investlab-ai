# Copy to .env.toss; fill locally. Never send these values in chat or commit them.
INVESTLAB_AI_TOSS_CLIENT_ID=
INVESTLAB_AI_TOSS_CLIENT_SECRET=
# Default: at most 5 total REST requests/sec per credential on this PC.
# Actual response headers and Retry-After can reduce this further.
INVESTLAB_AI_TOSS_REQUESTS_PER_SECOND=5
INVESTLAB_AI_TOSS_QUOTE_CACHE_SECONDS=15
INVESTLAB_AI_TOSS_CANDLE_CACHE_SECONDS=300
